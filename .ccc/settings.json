{
  "$schemaVersion": "1",
  "version": "1.0.0",
  "name": "dagaroost",
  "emoji": "🦘",
  "paths": [
    "/private/var/dagaroost/workspace"
  ],
  "agents-dir": "ai/agents",
  "delegates": [
    {
      "name": "liaison",
      "agent": "liaison",
      "instance-pattern": "{PROJECT}-{AGENT}",
      "emoji": "🔗",
      "model": "haiku"
    },
    {
      "name": "ccc",
      "agent": "ccc",
      "instance-pattern": "{PROJECT}-{AGENT}",
      "emoji": "Σ",
      "model": "haiku"
    },
    {
      "name": "dummy",
      "agent": "dummy",
      "instance-pattern": "{PROJECT}-{AGENT}",
      "emoji": "🧪",
      "model": "sonnet",
      "conductor": "basic"
    },
    {
      "name": "dummx",
      "agent": "dummx",
      "instance-pattern": "{PROJECT}-{AGENT}",
      "emoji": "🧪",
      "conductor": "off"
    },
    {
      "name": "dummg",
      "agent": "dummg",
      "instance-pattern": "{PROJECT}-{AGENT}",
      "emoji": "🧪",
      "conductor": "off",
      "permission-mode": "auto"
    }
  ],
  "durable": [
    "liaison",
    "ccc"
  ],
  "file_watchers": {
    "globs": [
      {
        "pattern": "**/effort/**/*.md",
        "scopes": [
          "list",
          "ready"
        ]
      },
      {
        "pattern": "**/design/**/*.md",
        "scopes": [
          "list",
          "ready"
        ]
      },
      {
        "pattern": "**/milestones/**/*.md",
        "scopes": [
          "list",
          "ready"
        ]
      },
      {
        "pattern": "**/goals/**/*.md",
        "scopes": [
          "list"
        ]
      },
      {
        "pattern": "**/aiqs.md",
        "scopes": [
          "list",
          "ready"
        ]
      },
      {
        "pattern": "**/.ccc/*.json",
        "scopes": [
          "list"
        ]
      },
      {
        "pattern": "**/inbox/**/*.md",
        "scopes": []
      },
      {
        "pattern": "**/active/**/*.md",
        "scopes": []
      },
      {
        "pattern": "**/pending/**/*.md",
        "scopes": []
      },
      {
        "pattern": "**/archive/**/*.md",
        "scopes": []
      },
      {
        "pattern": "**/messages/**/*.md",
        "scopes": []
      }
    ]
  },
  "peer_roots": [
    {
      "path": "../messages",
      "purpose": "Cross-agent message bodies — content-path target for MSG/REQ/REP artifacts."
    },
    {
      "path": "../inbox",
      "purpose": "Cross-project handoff intake (post-EPI-FLOW REQ ingest path; some hosts unprovisioned)."
    },
    {
      "path": "../cache",
      "purpose": "Per-project derived caches — index rebuilds, ccc-combine state, etc."
    },
    {
      "path": "../projects",
      "purpose": "Sibling projects under the same CCC container (overseer + cross-project agents)."
    }
  ]
}
